# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ecommerce_db

# --- JWT ---
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Razorpay ---
# Get real values from https://dashboard.razorpay.com/app/keys (test mode
# keys are free and safe for development). The webhook secret is set when
# you configure a webhook endpoint in the Razorpay dashboard, separately
# from the API key pair.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- Seed script (python seed.py) ---
# Credentials for the one bootstrap SUPER_ADMIN account seed.py creates.
# Change the password before deploying anywhere beyond local dev.
DEFAULT_ADMIN_EMAIL=admin@shopsphere.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_FULL_NAME=ShopSphere Admin
